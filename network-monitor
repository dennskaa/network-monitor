#!/bin/bash

# ==========================================
# NETWORK MONITOR TOOL
# ==========================================

# Warna
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Konfigurasi
CONFIG_FILE="$HOME/.network_monitor_config"
LOG_FILE="$HOME/.network_monitor.log"

# Fungsi bantuan
show_help() {
    echo "=========================================="
    echo "     NETWORK MONITOR TOOL"
    echo "=========================================="
    echo ""
    echo "Penggunaan:"
    echo "  ./network-monitor ping <host>        - Ping host"
    echo "  ./network-monitor monitor <host>     - Monitor terus menerus"
    echo "  ./network-monitor add <host>         - Tambah host ke daftar"
    echo "  ./network-monitor list               - Lihat daftar host"
    echo "  ./network-monitor check-all          - Cek semua host"
    echo "  ./network-monitor speedtest          - Test kecepatan internet"
    echo "  ./network-monitor ports <host>       - Scan port terbuka"
    echo ""
    echo "Contoh:"
    echo "  ./network-monitor ping google.com"
    echo "  ./network-monitor monitor 8.8.8.8"
    echo "  ./network-monitor add 192.168.1.1"
    echo "  ./network-monitor check-all"
    echo ""
}

# Fungsi ping
ping_host() {
    local host="$1"
    echo -e "${BLUE}▶ Pinging $host...${NC}"
    echo ""
    
    # Ping 4 kali
    ping -c 4 "$host" 2>/dev/null
    
    if [ $? -eq 0 ]; then
        echo ""
        echo -e "${GREEN}✅ Host $host is UP${NC}"
    else
        echo ""
        echo -e "${RED}❌ Host $host is DOWN${NC}"
    fi
}

# Fungsi monitor terus menerus
monitor_host() {
    local host="$1"
    echo -e "${BLUE}▶ Monitoring $host (CTRL+C to stop)${NC}"
    echo ""
    
    while true; do
        timestamp=$(date '+%Y-%m-%d %H:%M:%S')
        
        if ping -c 1 "$host" > /dev/null 2>&1; then
            echo -e "[$timestamp] ${GREEN}✅ UP${NC} - $host"
        else
            echo -e "[$timestamp] ${RED}❌ DOWN${NC} - $host"
            # Log jika down
            echo "[$timestamp] DOWN - $host" >> "$LOG_FILE"
        fi
        
        sleep 5  # Cek setiap 5 detik
    done
}

# Fungsi tambah host
add_host() {
    local host="$1"
    
    # Cek apakah sudah ada
    if grep -q "^$host$" "$CONFIG_FILE" 2>/dev/null; then
        echo -e "${YELLOW}⚠ Host $host sudah ada di daftar!${NC}"
        return
    fi
    
    echo "$host" >> "$CONFIG_FILE"
    echo -e "${GREEN}✅ Host $host berhasil ditambahkan!${NC}"
}

# Fungsi lihat daftar host
list_hosts() {
    if [ ! -f "$CONFIG_FILE" ] || [ ! -s "$CONFIG_FILE" ]; then
        echo -e "${YELLOW}⚠ Belum ada host terdaftar.${NC}"
        echo "Tambahkan dengan: ./network-monitor add <host>"
        return
    fi
    
    echo -e "${BLUE}📋 Daftar Host Terdaftar:${NC}"
    echo "================================"
    
    while read -r host; do
        # Cek status
        if ping -c 1 "$host" > /dev/null 2>&1; then
            status="${GREEN}UP${NC}"
        else
            status="${RED}DOWN${NC}"
        fi
        echo -e "$host → $status"
    done < "$CONFIG_FILE"
}

# Fungsi cek semua host
check_all() {
    if [ ! -f "$CONFIG_FILE" ] || [ ! -s "$CONFIG_FILE" ]; then
        echo -e "${YELLOW}⚠ Belum ada host terdaftar.${NC}"
        echo "Tambahkan dengan: ./network-monitor add <host>"
        return
    fi
    
    echo -e "${BLUE}🔍 Checking all hosts...${NC}"
    echo "================================"
    echo ""
    
    while read -r host; do
        echo -n "Checking $host... "
        if ping -c 2 "$host" > /dev/null 2>&1; then
            echo -e "${GREEN}✅ UP${NC}"
        else
            echo -e "${RED}❌ DOWN${NC}"
            echo "[$(date)] DOWN - $host" >> "$LOG_FILE"
        fi
    done < "$CONFIG_FILE"
    
    echo ""
    echo -e "${GREEN}✅ Selesai!${NC}"
}

# Fungsi speedtest (sederhana)
speedtest() {
    echo -e "${BLUE}▶ Testing internet speed...${NC}"
    echo ""
    
    # Download test file
    echo "Downloading test file..."
    start=$(date +%s.%N)
    curl -s -o /dev/null http://speedtest.tele2.net/10MB.zip
    end=$(date +%s.%N)
    
    duration=$(echo "$end - $start" | bc)
    speed=$(echo "10 / $duration" | bc)
    
    echo -e "${GREEN}✅ Download speed: ${speed} MB/s${NC}"
    
    # Ping test
    echo ""
    echo "Ping test to google.com..."
    ping -c 4 google.com | tail -1
}

# Fungsi scan port
scan_ports() {
    local host="$1"
    
    echo -e "${BLUE}🔍 Scanning common ports on $host...${NC}"
    echo "================================"
    
    ports=("22" "80" "443" "3306" "5432" "8080" "8443")
    
    for port in "${ports[@]}"; do
        timeout 2 bash -c "echo > /dev/tcp/$host/$port" 2>/dev/null
        if [ $? -eq 0 ]; then
            echo -e "Port $port: ${GREEN}✅ OPEN${NC}"
        else
            echo -e "Port $port: ${RED}❌ CLOSED${NC}"
        fi
    done
}

# MAIN PROGRAM
case "$1" in
    ping)
        if [ -z "$2" ]; then
            echo -e "${RED}Error: Host tidak boleh kosong!${NC}"
            show_help
            exit 1
        fi
        ping_host "$2"
        ;;
    monitor)
        if [ -z "$2" ]; then
            echo -e "${RED}Error: Host tidak boleh kosong!${NC}"
            show_help
            exit 1
        fi
        monitor_host "$2"
        ;;
    add)
        if [ -z "$2" ]; then
            echo -e "${RED}Error: Host tidak boleh kosong!${NC}"
            show_help
            exit 1
        fi
        add_host "$2"
        ;;
    list)
        list_hosts
        ;;
    check-all)
        check_all
        ;;
    speedtest)
        speedtest
        ;;
    ports)
        if [ -z "$2" ]; then
            echo -e "${RED}Error: Host tidak boleh kosong!${NC}"
            show_help
            exit 1
        fi
        scan_ports "$2"
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo -e "${RED}Error: Perintah '$1' tidak dikenal!${NC}"
        show_help
        exit 1
        ;;
esac
